{
  "info": {
    "name": "Team08 Online Marketplace API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "buyer_token",
      "value": ""
    },
    {
      "key": "artisan_token",
      "value": ""
    }
